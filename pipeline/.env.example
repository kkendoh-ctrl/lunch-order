# ─── パス設定(必須) ─────────────────────────────────
# Windows ユーザー名に合わせて <user> を置換
JPR_INBOX_PATH=/mnt/c/Users/<user>/iCloud Drive/Just Press Record
VAULT_PATH=/mnt/c/Users/<user>/iCloud Drive/音声記憶

# ─── 軽フィルタ ─────────────────────────────────
# 10秒未満は除外
SKIP_DURATION_THRESHOLD_S=10
# 無音率 95% 超は除外(-40dBFS 未満を無音と判定)
SKIP_SILENCE_RATIO=0.95
SKIP_SILENCE_DB=-40

# ─── WhisperX ─────────────────────────────────
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ja

# Vault 内の固有名詞ヒント(相対パスは VAULT_PATH からの相対)
WHISPER_INITIAL_PROMPT_PATH=_プロンプト/whisper-initial-prompt.txt

# ─── 単語アライメント(WhisperX 標準機能) ─────────────────
WHISPER_ALIGN_ENABLED=true

# ─── ファイル安定化待ち ─────────────────────────────────
# iCloud のダウンロード完了を待つため、サイズが N 秒変化しなければ確定とみなす
FILE_STABLE_WAIT_S=5
FILE_STABLE_POLL_S=2
