# ─── パス設定(必須) ─────────────────────────────────
# Windows ユーザー名に合わせて <user> を置換
JPR_INBOX_PATH=/mnt/c/Users/<user>/iCloud Drive/Just Press Record
VAULT_PATH=/mnt/c/Users/<user>/iCloud Drive/音声記憶

# ─── 軽フィルタ ─────────────────────────────────
# 10秒未満は除外
SKIP_DURATION_THRESHOLD_S=10
# 無音率 95% 超は除外(-40dBFS 未満を無音と判定)
SKIP_SILENCE_RATIO=0.95
SKIP_SILENCE_DB=-40

# ─── WhisperX ─────────────────────────────────
# bronzeman (Ultra 5 225U) ではストレージとCPU時間の都合で turbo が現実的。
# モデルサイズ・速度の目安 (large-v3 比):
#   tiny           ~75MB   速い・精度落ちる
#   base           ~150MB
#   small          ~500MB
#   medium         ~1.5GB  日本語そこそこ
#   large-v3-turbo ~1.5GB  large-v3 比 5x 速い・精度ほぼ同等 (日本語→日本語推奨)
#   large-v3       ~3GB    最高精度・最遅
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ja

# Vault 内の固有名詞ヒント(相対パスは VAULT_PATH からの相対)
WHISPER_INITIAL_PROMPT_PATH=_プロンプト/whisper-initial-prompt.txt

# ─── 単語アライメント(WhisperX 標準機能) ─────────────────
WHISPER_ALIGN_ENABLED=true

# ─── 話者分離(Phase 5c, pyannote.audio + HuggingFace モデル) ─────────────
# true にすると WhisperX の diarization pipeline を有効化
# 初回起動時に pyannote モデル(~1GB)が DL される。HF_TOKEN 必須(下記)
DIARIZE_ENABLED=false
# https://huggingface.co/settings/tokens で発行(pyannote のモデルカード同意も必要)
HF_TOKEN=

# ─── ファイル安定化待ち ─────────────────────────────────
# iCloud のダウンロード完了を待つため、サイズが N 秒変化しなければ確定とみなす
FILE_STABLE_WAIT_S=5
FILE_STABLE_POLL_S=2

# ─── Claude API (Phase 2: 構造化) ─────────────────────────────────
# 未設定なら Phase 2 はスキップされ Phase 1 (文字起こし) までで止まる
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
# Vault 内の構造化プロンプト(相対パスは VAULT_PATH からの相対)
STRUCTURING_PROMPT_PATH=_プロンプト/claude-structuring.md
# Claude API 呼び出しの max_tokens
ANTHROPIC_MAX_TOKENS=8192
# adaptive thinking の effort: low / medium / high / max
ANTHROPIC_EFFORT=medium

# ─── Phase 4: PII マスキング ─────────────────────────────────
# Claude に送る直前にテキスト中の PII (電話番号・メール・郵便番号・
# 申請番号・カード番号) を [...] トークンに置換する。
# vault に書く「全文(タイムスタンプ付き)」は **マスクされない** ことに注意:
# vault は ThinkPad ローカルにあり OS 暗号化前提のため。
PII_MASK_ENABLED=true

# 任意のユーザー辞書(flat YAML dict)。substring 置換に使う。
# 例: pii_dict.yaml
#   田中花子: "[個人A]"
#   090-1234-5678: "[電話番号]"
# Vault 外で管理する想定。Git にはコミットしない。
PII_DICT_PATH=

# 許可リスト(Phase 4 では未使用、Phase 5+ で NER と組み合わせる時のため)
PII_ALLOWLIST_PATH=

# ─── Phase 5: Reminders 連携 ─────────────────────────────────
# Vault 集約のたびに <vault>/_reminders/todos.ics を出力する。
# iOS Files アプリで開く or ショートカットで Reminders.app に取込み。
REMINDERS_ENABLED=true
